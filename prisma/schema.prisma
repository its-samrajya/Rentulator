generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id  String   @id @default(uuid())
  name String
  email String @unique
  password String
  number Int @unique
  address String
  rooms Room[] 
}
model Room{
 id String @id @default(uuid()) 
 price  Int 
 description String
 userId String
 user User @relation(fields: [userId], references: [id])

}