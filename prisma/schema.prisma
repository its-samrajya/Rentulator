generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?              @map("email_verified")
  image                 String?
  password              String?
  role                  UserRole               @default(USER)
  accounts              Account[]
  isTwoFactorEnabled    Boolean                @default(false)
  twoFactorConfirmation TwoFactorConfirmation?
  tenant                Tenant?

  @@map("users")
}

model Room {
  id          String   @id @default(uuid())
  meterId     String
  price       Int
  roomNumber  Int
  floor       String
  description String
  createdAt   DateTime
  updatedAt   DateTime

  electricMeter ElectricMeter @relation(fields: [meterId], references: [id])
  occupancies   Occupancy[]

  @@map("rooms")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorConfirmation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model Tenant {
  id          String      @id @default(cuid())
  name        String
  userId      String      @unique // link to User who sign via GOOGLE
  occupancies Occupancy[]
  invoices    Invoice[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Occupancy {
  id          String   @id @default(cuid())
  tenantId    String
  roomId      String
  moveInDate  DateTime
  moveOutDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [roomId], references: [id])

  @@map("occupancies")
}

model ElectricMeter {
  id               String            @id @default(cuid())
  meterNumber      String            @unique
  rooms            Room[]
  electricReadings ElectricReading[]
  electricBill     ElectricBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ElectricReading {
  id             String   @id @default(cuid())
  meterId        String
  readingDate    DateTime
  currentReading Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  electricMeter ElectricMeter? @relation(fields: [meterId], references: [id])
}

model ElectricBill {
  id              String   @id @default(cuid())
  meterId         String
  invoiceId       String?
  fromDate        DateTime
  toDate          DateTime
  previousReading Int
  currentReading  Int
  unitsConsumed   Int
  ratePerUnit     Int
  totalAmount     Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  electricMeter ElectricMeter? @relation(fields: [meterId], references: [id])
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
}

model Invoice {
  id           String         @id @default(cuid())
  tenantId     String
  totalAmount  Int
  dueDate      DateTime
  electricBill ElectricBill[]
  status       PaymentStatus  @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("invoices")
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Int
  paidAt    DateTime @default(now())
  note      String? // ex: cash or bank
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Setting {
  id           String   @id @default(cuid())
  electricRate Int
  dueDate      Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
