generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id  Int   @id @default(autoincrement())
  name String
  email String @unique
  password String
  number Int @unique
  address String
  rooms Room[] 
}
model Room{
 id Int @id @default(autoincrement()) 
 price  Int 
 description String
 userId Int
 user User @relation(fields: [userId], references: [id])

}